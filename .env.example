# Database. Defaults to a local SQLite file (file:expenses.db) when unset.
# For a hosted deploy (e.g. Vercel), create a free Turso database and set both:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# Password-protect the app (strongly recommended once it's on the internet).
# Leave unset for local use without a login.
# APP_PASSWORD=

# Optional. With a key, notes are read by Claude and cross-checked by the built-in rule parser.
# Without it, the app uses the rule parser only (works offline, no cost).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
# ANTHROPIC_MODEL=
